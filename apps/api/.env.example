# ISSRMS Environment Template (Safe for Version Control)
NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRES_IN=8h

# Zone 1 (Institutional Legacy - Read Only)
ZONE1_DB_HOST=127.0.0.1
ZONE1_DB_PORT=3306
ZONE1_DB_NAME=sjsm_institutional_zone1
ZONE1_DB_USER=issrms_readonly
ZONE1_DB_PASS=
ZONE1_DB_CONNECTION_LIMIT=10

# Zone 2 (ISSRMS Operational - MySQL Read/Write)
ZONE2_DB_HOST=127.0.0.1
ZONE2_DB_PORT=3306
ZONE2_DB_NAME=sjsm_issrms_zone2
ZONE2_DB_USER=issrms_app
ZONE2_DB_PASS=
ZONE2_DB_CONNECTION_LIMIT=20
